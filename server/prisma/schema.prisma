// LabShare backend schema — matches the spec (mục 2).
// Production uses Postgres (Neon); set DATABASE_URL to the Neon connection
// string. For a quick local run you can point it at a local Postgres instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  studentId    String?  @unique
  email        String   @unique
  passwordHash String
  phone        String?
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  consignments Consignment[]
  products     Product[]     @relation("SeniorProducts")
  bookings     Booking[]     @relation("RenterBookings")
}

model Category {
  id           String        @id // "do-luong" | "vi-dieu-khien" | "plc" | "khac"
  label        String
  emoji        String
  consignments Consignment[]
  products     Product[]
}

model PickupPoint {
  id       String    @id
  name     String
  hours    String
  bookings Booking[]
}

model Consignment {
  id             String    @id @default(cuid())
  name           String
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  seniorId       String
  senior         User      @relation(fields: [seniorId], references: [id])
  estimatedValue Int
  desc           String
  contactName    String?
  contactPhone   String?
  status         String    @default("pending") // pending | approved | rejected
  submittedAt    DateTime  @default(now())
  reviewedAt     DateTime?
  productId      String?   @unique
  product        Product?  @relation(fields: [productId], references: [id])
}

model Product {
  id               String   @id @default(cuid())
  name             String
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  pricePerDay      Int
  marketValue      Int
  grade            String                 // "A" | "B"
  sealCode         String   @unique
  appraisedAt      DateTime
  lastTestedAt     DateTime
  desc             String
  specs            String                  // JSON string [{label, value}]
  included         String                  // JSON string string[]
  notIncluded      String                  // JSON string string[]
  seniorId         String
  senior           User     @relation("SeniorProducts", fields: [seniorId], references: [id])
  splitSeniorPct   Int                     // e.g. 60
  splitPlatformPct Int                     // e.g. 40
  rating           Float    @default(5.0)
  rentedCount      Int      @default(0)
  earnedSoFar      Int      @default(0)
  status           String   @default("active") // active | retired
  unavailableDays  String   @default("[]") // JSON string number[]

  consignment      Consignment?
  bookings         Booking[]
}

model Booking {
  id              String      @id @default(cuid())
  productId       String
  product         Product     @relation(fields: [productId], references: [id])
  renterId        String
  renter          User        @relation("RenterBookings", fields: [renterId], references: [id])
  pickupPointId   String
  pickupPoint     PickupPoint @relation(fields: [pickupPointId], references: [id])
  startDate       DateTime
  endDate         DateTime
  nights          Int
  rentalCost      Int
  deposit         Int
  insuranceFee    Int
  total           Int
  contactName     String?
  contactPhone    String?
  status          String      @default("pending") // pending | confirmed | rejected | picked_up | completed
  handoverAt      DateTime?
  returnAt        DateTime?
  depositReturned Boolean     @default(false)
  createdAt       DateTime    @default(now())
}

model LedgerEntry {
  id        String   @id @default(cuid())
  type      String   // rental_revenue | insurance_fee | deposit_hold | deposit_release | senior_payout | repair_fee | liquidation
  amount    Int
  bookingId String?
  productId String?
  note      String?
  createdAt DateTime @default(now())
}
